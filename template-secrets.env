# ============================================================
# Secrets
# ============================================================
# Copy this file to secrets.env and fill in your actual values.
# Config (non-secret) values live in cfg.yml — do not add them here.
# ============================================================

# Model provider — one key per provider you enable.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Plaid (REQUIRED for the money capability)
PLAID_CLIENT_ID=your_plaid_client_id_here
PLAID_SECRET=your_plaid_secret_here
